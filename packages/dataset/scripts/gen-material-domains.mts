/**
 * Generates frontend/src/data/materialDomains.ts: the domain + weekday rotation for each
 * domain-farmed material (talent books, weapon-ascension mats) referenced in our dataset. Used by
 * the "Farmable today" calendar (D) to answer "which of my characters' talent books drop today?".
 *
 * Run: npx tsx packages/dataset/scripts/gen-material-domains.mts
 */
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import gdb from "genshin-db";

const here = dirname(fileURLToPath(import.meta.url));
const ROOT = join(here, "..", "..", "..");
const DATA = join(ROOT, "data", "genshindb");
const OUT = join(ROOT, "frontend", "src", "data", "materialDomains.ts");

const characters = JSON.parse(readFileSync(join(DATA, "characters.json"), "utf8")) as {
  id: string;
  talentMaterials?: { name: string }[];
}[];
const weapons = JSON.parse(readFileSync(join(DATA, "weapons.json"), "utf8")) as {
  id: string;
  ascensionMaterials?: { name: string }[];
}[];

const names = new Set<string>();
for (const c of characters) for (const m of c.talentMaterials ?? []) names.add(m.name);
for (const w of weapons) for (const m of w.ascensionMaterials ?? []) names.add(m.name);

const out: Record<string, { domain: string; days: string[]; kind: "talent" | "weapon" }> = {};
for (const name of [...names].sort()) {
  const m = gdb.materials(name, { queryLanguages: ["English"] }) as
    | { dropDomainName?: string; daysOfWeek?: string[]; typeText?: string }
    | undefined;
  if (!m?.dropDomainName || !m.daysOfWeek?.length) continue;
  const type = (m.typeText ?? "").toLowerCase();
  const kind = type.includes("talent") ? "talent" : type.includes("weapon") ? "weapon" : "talent";
  out[name] = { domain: m.dropDomainName, days: m.daysOfWeek, kind };
}

// Per-character talent domain (a character's talent books all come from one domain).
const charDomains: Record<string, { book: string; domain: string; days: string[] }> = {};
for (const c of characters) {
  const book = (c.talentMaterials ?? []).find((m) => out[m.name]?.kind === "talent");
  if (book && out[book.name]) {
    charDomains[c.id] = { book: book.name, domain: out[book.name]!.domain, days: out[book.name]!.days };
  }
}

// Per-weapon ascension domain (a weapon's ascension mats come from one weapon domain).
const weaponDomains: Record<string, { domain: string; days: string[] }> = {};
for (const w of weapons) {
  const mat = (w.ascensionMaterials ?? []).find((m) => out[m.name]?.kind === "weapon");
  if (mat && out[mat.name]) {
    weaponDomains[w.id] = { domain: out[mat.name]!.domain, days: out[mat.name]!.days };
  }
}

const body =
  "/** Auto-generated by packages/dataset/scripts/gen-material-domains.mts — do not edit by hand.\n" +
  " * Domain + weekday rotation for each domain-farmed material, for the Farmable calendar (D). */\n" +
  "export interface MaterialDomain {\n  domain: string;\n  days: string[];\n  kind: \"talent\" | \"weapon\";\n}\n" +
  "export const MATERIAL_DOMAINS: Record<string, MaterialDomain> = " +
  JSON.stringify(out, null, 2) +
  ";\n\n" +
  "/** Each character's talent-book domain, for the Farmable calendar. */\n" +
  "export const CHARACTER_TALENT_DOMAINS: Record<string, { book: string; domain: string; days: string[] }> = " +
  JSON.stringify(charDomains, null, 2) +
  ";\n\n" +
  "/** Each weapon's ascension-material domain, for the Farmable calendar. */\n" +
  "export const WEAPON_DOMAINS: Record<string, { domain: string; days: string[] }> = " +
  JSON.stringify(weaponDomains, null, 2) +
  ";\n";
writeFileSync(OUT, body);
console.log(
  `Wrote ${Object.keys(out).length} material domains + ${Object.keys(charDomains).length} character + ${Object.keys(weaponDomains).length} weapon domains -> ${OUT}`,
);
